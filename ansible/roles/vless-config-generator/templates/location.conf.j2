location = /internal/auth {
    internal;
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
}

location = /internal/admin-auth {
    internal;
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/admin/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
}

location @site_login {
    return 302 /login;
}

location @admin_login {
    return 302 /admin/login;
}

# Gated the same as `/` (any Discord grant, see the front-door location
# below) rather than left open — reaching `/login` at all in the normal
# flow already implies passing that gate first (the SPA it's linked from
# is itself behind it), and this also lets the backend silently sign a
# Discord-authenticated visitor into an already-linked account without
# the email+uuid form (see app.py's login_form/login_submit).
location = /login {
    auth_request /internal/zw-auth;
    auth_request_set $discord_user_id $upstream_http_x_discord_user_id;
    error_page 401 = @zw_login;
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/login;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Discord-User-Id $discord_user_id;
}

location = /logout {
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/logout;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /api/ {
    auth_request /internal/auth;
    error_page 401 = @site_login;
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Exact match takes precedence over the /api/ prefix above — gated the
# same as `/login` (Discord, not the site's own auth_request) since this
# feeds the top-right user menu's Discord identity, not anything
# site-login-specific.
location = /api/whoami {
    auth_request /internal/zw-auth;
    auth_request_set $discord_user_id $upstream_http_x_discord_user_id;
    auth_request_set $discord_avatar_url $upstream_http_x_discord_avatar_url;
    auth_request_set $discord_access_level $upstream_http_x_discord_access_level;
    error_page 401 = @zw_login;
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/api/whoami;
    proxy_set_header Host $host;
    proxy_set_header X-Discord-User-Id $discord_user_id;
    proxy_set_header X-Discord-Avatar-Url $discord_avatar_url;
    proxy_set_header X-Discord-Access-Level $discord_access_level;
}

location /admin/login {
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/admin/login;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /admin/logout {
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/admin/logout;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /admin/ {
    auth_request /internal/admin-auth;
    error_page 401 = @admin_login_or_discord;
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/admin/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# OR path into /admin/: if vless-gen's own admin_session check above just
# failed, ALSO try a Discord admin-level grant for this service before
# giving up — nginx allows only one auth_request per location, so this
# second check has to live in its own named location, reached via the
# error_page above rather than stacked onto /admin/ itself. Neither check
# passing (401 or 403 from /internal/zw-admin-auth — no session at all, or
# a session that just isn't admin-level here) falls through to vless-gen's
# own @admin_login, not Discord: someone with the shared admin credential
# but no Discord grant should still get in exactly as before.
location @admin_login_or_discord {
    auth_request /internal/zw-admin-auth;
    error_page 401 403 = @admin_login;
    # No URI part on proxy_pass here — nginx forbids one on a named
    # location's proxy_pass ("proxy_pass cannot have URI part ... inside
    # named location"). The original request URI (already /admin/...) is
    # forwarded unchanged, which is equivalent to /admin/'s own proxy_pass.
    proxy_pass http://{{ vless_config_generator_api_upstream_name }};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /internal/zw-admin-auth {
    internal;
    proxy_pass http://{{ meow_elite_club_portal_upstream_name }}/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Service-Slug "{{ vless_config_generator_service_slug }}";
    proxy_set_header X-Require-Level "admin";
}

# Discord SSO gate (meow-elite-club-portal) on top of the site's own login —
# see docs/portal-architecture.md in infra for the full cross-domain bridge
# flow. Only the front-door location below is gated: nginx allows exactly
# one auth_request per location, so it can't be stacked onto /api/ or
# /admin/ without replacing their own existing auth_request. In the normal
# browser flow this is equivalent to gating the whole site (the SPA is
# always loaded from `/` first, and only then calls /api/ or /admin/) — the
# one gap is a client that already holds a stolen/replayed vless-gen session
# cookie hitting /api/ or /admin/ directly, bypassing Discord entirely.
location / {
    auth_request /internal/zw-auth;
    error_page 401 = @zw_login;
    alias      /usr/share/nginx/html/static/vless-config-generator/;
    index      index.html;
    try_files  $uri $uri/ =404;
    add_header Cache-Control "no-cache" always;
}

location = /internal/zw-auth {
    internal;
    proxy_pass http://{{ meow_elite_club_portal_upstream_name }}/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Service-Slug "{{ vless_config_generator_service_slug }}";
}

location = /internal/bridge {
    proxy_pass http://{{ meow_elite_club_portal_upstream_name }}/bridge/consume;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
}

location @zw_login {
    return 302 https://meow-elite.club/login?next=$scheme://$host$request_uri;
}
