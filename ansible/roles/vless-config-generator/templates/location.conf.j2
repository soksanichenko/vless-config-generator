location = /internal/auth {
    internal;
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URI $request_uri;
}

location @error401 {
    add_header WWW-Authenticate "Basic realm=\"{{ vless_config_generator_domain }}\"" always;
    return 401;
}

location /api/ {
    auth_request /internal/auth;
    error_page 401 = @error401;
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /admin/ {
    auth_basic "{{ vless_config_generator_admin_htpasswd_realm }}";
    auth_basic_user_file {{ nginx_confd_container_path }}/htpasswd/{{ vless_config_generator_admin_htpasswd_file }};
    proxy_pass http://{{ vless_config_generator_api_upstream_name }}/admin/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location / {
    auth_request /internal/auth;
    error_page 401 = @error401;
    alias      /usr/share/nginx/html/static/vless-config-generator/;
    index      index.html;
    try_files  $uri $uri/ =404;
    add_header Cache-Control "no-cache" always;
}
